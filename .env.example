# Security
JWT_SECRET=change-this-secret-in-production
CLIENT_URL=http://localhost:8080

# MongoDB (used by docker-compose)
MONGODB_URI=mongodb://mongo:27017/medibook

# App
SLOT_LOCK_MINUTES=5
CONSULTATION_FEE=500
LOG_LEVEL=info

# Stripe (optional — mock payment when empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional — logged to console when empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=MediBook <your@gmail.com>
